NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:pass@localhost:5432/cafe_menu?schema=public
BUSINESS_TIMEZONE=Asia/Tehran
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_MENU_BASE_URL=http://localhost:5173/menu
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL=1d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
JWT_REFRESH_TTL=365d
ADMIN_MOBILE=09123456789
ADMIN_PASSWORD=changeme123
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace_with_a_long_random_secret
AUTH_DEMO_OTP_ENABLED=true
SMS_PROVIDER=mock
SMS_IR_API_KEY=
SMS_IR_API_BASE_URL=https://api.sms.ir/v1
SMS_IR_OTP_TEMPLATE_ID=
# Parameter name defined in the SMS.ir verify template (without #)
SMS_IR_OTP_PARAM_NAME=Code
PAYMENT_PROVIDER=zarinpal
PAYMENT_MOCK_ENABLED=false

# Must be publicly reachable backend callback, e.g. https://api.example.com/api/v1/payments/zarinpal/callback
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/v1/payments/zarinpal/callback

UPLOAD_MAX_BYTES=5242880
