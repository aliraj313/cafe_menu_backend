generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

/// Extensible list of payment gateways. Add new values when integrating more providers.
enum PaymentGatewayProvider {
  ZARINPAL
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  /// Price in Rial (integer). Exposed as string in API JSON.
  price       BigInt
  images      String[] @default([])
  mealType    MealType
  isAvailable Boolean  @default(true)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([mealType])
  @@index([isAvailable])
  @@map("products")
}

/// Singleton cafe/restaurant settings (one row, id fixed to SETTINGS.SINGLETON_ID).
model Settings {
  id                       Int                     @id @default(autoincrement())
  cafeName                 String
  slogan                   String?
  logoUrl                  String?
  description              String?
  phone                    String?
  /// Free-text working hours, e.g. "همه‌روزه ۸ صبح تا ۱۱ شب"
  workingHours             String?
  address                  String?
  instagramUrl             String?
  telegramUrl              String?
  ordersAndPaymentsEnabled Boolean                 @default(false)
  /// Active gateway when orders/payments are enabled. Null when disabled.
  paymentProvider          PaymentGatewayProvider?
  /// Provider-specific credentials/config (shape depends on paymentProvider).
  /// Zarinpal example: { "merchantId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" }
  paymentGatewayConfig     Json?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@map("settings")
}
